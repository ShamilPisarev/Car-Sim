config_version=5

[application]
config/name="Car Sim"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120

[rendering]
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.9, 1)
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
environment/glow/upscale_mode=1
renderer/rendering_method.web="gl_compatibility"
lights_and_shadows/directional_shadow/size.web=4096
anti_aliasing/quality/msaa_3d.web=0

[shader_globals]

wetness={
"type": "float",
"value": 0.0
}
